# Copy to .env and fill in. Never commit the real .env file.

# Garmin Connect — your normal login, authenticated the same way the mobile app does
GARMIN_EMAIL=
GARMIN_PASSWORD=

# The safety catch on the only thing in this app that writes anywhere.
# Left unset — the default — the app is read-and-plan only: it reads your
# plan, you move sessions, and "Preview what would be sent" works in full, but
# no request ever reaches your Garmin account. An accidental run, a stray
# script or a browser tab left open cannot put a workout on your Edge 520.
# Set it to 1 when you actually want to send, and restart.
#
#   TRAINING_SYNC_ALLOW_GARMIN_WRITES=1
#
# This is separate from GARMIN_EMAIL/GARMIN_PASSWORD on purpose: the login
# makes a write *possible*, this makes it *intended*. Both are required.
# Approving a session for push is still a third, per-workout consent — the app
# never sends anything you haven't ticked.
#
# Sending is the ONLY thing this app writes to your Garmin account. It does
# not take sessions off your Garmin calendar, and it never deletes anything
# from your Garmin library. If you want a session off the calendar, remove it
# in Garmin Connect — that takes one click and tells you plainly whether it
# worked, which is more than this app could honestly promise. Skipping or
# moving a session here changes your plan and nothing on Garmin; where a copy
# of it is still on your calendar the app says so and says where to go.
TRAINING_SYNC_ALLOW_GARMIN_WRITES=

# Your FTP in watts. Optional but recommended: with it, workouts pushed to
# Garmin carry real power targets (e.g. 238-262W for threshold). Without it
# they fall back to targeting your Garmin power zone by number, which the
# Edge resolves against the zones already set on the device.
GARMIN_FTP=

# The zone your training calendar is written in, as an IANA name
# (Europe/London, America/Denver, Australia/Sydney). It decides which *day*
# a timed workout falls on: a session at 23:30 UTC is Saturday in London in
# winter and Sunday in summer, and only a named zone knows which. Leave it
# blank and the app uses TZ, then the system zone (/etc/timezone,
# /etc/localtime) — set it explicitly if the machine's clock isn't in the
# same zone as your riding.
TRAINING_TZ=

# Where the local override store lives (day availability, your moves,
# approved suggestions, push status). Defaults to
# training-sync/.plan_state.json. Contains your plan — keep it out of git.
TRAINING_SYNC_STATE_PATH=

# Strava — create an app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# TrainingPeaks calendar feed — a personal ICS/webcal URL you generate
# yourself from TrainingPeaks Settings (used to subscribe to your schedule
# from Google Calendar/Outlook). Treat it as a secret. Works today, read-only.
TRAININGPEAKS_CALENDAR_FEED_URL=

# TrainingPeaks Partner API — only usable once approved as an integration
# partner (apply at https://www.trainingpeaks.com/partners/). Needed for
# structured fields and write-back. Leave blank otherwise.
TRAININGPEAKS_CLIENT_ID=
TRAININGPEAKS_CLIENT_SECRET=
TRAININGPEAKS_REFRESH_TOKEN=
