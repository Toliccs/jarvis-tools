# Copy to .env and fill in. Never commit the real .env file.

# Garmin Connect — your normal login, authenticated the same way the mobile app does
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Strava — create an app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# TrainingPeaks — only usable once approved as a Partner API integration
# (apply at https://www.trainingpeaks.com/partners/). Leave blank otherwise.
TRAININGPEAKS_CLIENT_ID=
TRAININGPEAKS_CLIENT_SECRET=
TRAININGPEAKS_REFRESH_TOKEN=
