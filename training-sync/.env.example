# Copy to .env and fill in. Never commit the real .env file.

# Garmin Connect — your normal login, authenticated the same way the mobile app does
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Strava — create an app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# TrainingPeaks calendar feed — a personal ICS/webcal URL you generate
# yourself from TrainingPeaks Settings (used to subscribe to your schedule
# from Google Calendar/Outlook). Treat it as a secret. Works today, read-only.
TRAININGPEAKS_CALENDAR_FEED_URL=

# TrainingPeaks Partner API — only usable once approved as an integration
# partner (apply at https://www.trainingpeaks.com/partners/). Needed for
# structured fields and write-back. Leave blank otherwise.
TRAININGPEAKS_CLIENT_ID=
TRAININGPEAKS_CLIENT_SECRET=
TRAININGPEAKS_REFRESH_TOKEN=
